# custom folder icons: the name is Icon followed by a carriage return
Icon

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# Build output
/server/dist/
/dist/
*.test
/server/kantahe

# Embedded at release build time by scripts/build-release.sh; never committed
/server/internal/webui/dist/*
!/server/internal/webui/dist/.gitkeep
!/server/internal/webui/dist/index.html
/server/internal/assets/soundfont/*.sf2

# TV packages (scripts/build-tizen.sh, scripts/build-webos.sh)
/build/
__pycache__/
# Samsung certificates and profiles are the owner's, never the repository's
*.p12
*.pwd
/tv/tizen/profiles.xml
# webOS device keys and passphrases are the owner's, never the repository's
*.pem
*.key
ssh_key*
id_rsa*
